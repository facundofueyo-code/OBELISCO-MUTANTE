{
  "name": "obelisco-mutante",
  "productName": "Obelisco Mutante",
  "version": "0.0.0",
  "description": "Obelisco Mutante — versión de escritorio",
  "main": "main.js",
  "private": true,
  "scripts": {
    "preparar": "node preparar.js",
    "jugar": "node preparar.js && electron .",
    "build": "node preparar.js && node build.js"
  },
  "devDependencies": {
    "@fontsource/chakra-petch": "5.3.0",
    "@fontsource/creepster": "5.3.0",
    "electron": "44.7.0",
    "electron-builder": "26.15.3"
  },
  "build": {
    "appId": "ar.facu.obeliscomutante",
    "productName": "Obelisco Mutante",
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.js",
      "preload.js",
      "app/**/*",
      "package.json"
    ],
    "win": {
      "target": [
        "portable",
        "nsis"
      ],
      "artifactName": "ObeliscoMutante-${version}-${arch}-${target}.${ext}"
    },
    "portable": {
      "artifactName": "ObeliscoMutante-${version}-portable.exe"
    },
    "nsis": {
      "artifactName": "ObeliscoMutante-${version}-instalador.exe",
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "shortcutName": "Obelisco Mutante"
    }
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/facundofueyo-code/OBELISCO-MUTANTE.git"
  }
}
